{
  "name": "vahoha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/splitRoadmaps.js",
    "dev": "vite",
    "start": "node --no-node-snapshot backend/server.js",
    "seed:roadmap": "node backend/seeders/roadmapSeeder.js",
    "seed:challenges": "node backend/seeders/challengeSeeder.js",
    "challenges:verify": "node backend/scripts/verifyChallenge.js",
    "seed:capstones": "node backend/seeders/capstoneSeeder.js",
    "capstone:prompt": "node backend/scripts/capstonePrompt.js",
    "capstone:reset": "node backend/scripts/resetCapstone.js",
    "capstone:reopen": "node backend/scripts/reopenCapstone.js",
    "capstone:testreview": "node backend/scripts/seedTestReview.js",
    "admin:grant": "node backend/scripts/grantAdmin.js",
    "migrate:slugs": "node backend/scripts/backfillTopicSlugs.js",
    "migrate:mastery": "node backend/scripts/recomputeMastery.js",
    "seed:concepts": "node backend/seeders/conceptSeeder.js",
    "seed:rubrics": "node backend/seeders/teachBackRubricSeeder.js",
    "prebuild": "node scripts/splitRoadmaps.js",
    "build": "vite build && vite build --ssr src/entry-prerender.jsx --outDir dist-ssr",
    "postbuild": "node scripts/seoPostBuild.js",
    "prebuild:staging": "node scripts/splitRoadmaps.js",
    "build:staging": "vite build --mode staging && vite build --mode staging --ssr src/entry-prerender.jsx --outDir dist-ssr",
    "postbuild:staging": "node scripts/seoPostBuild.js",
    "server": "nodemon --exec \"node --no-node-snapshot\" backend/server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "redis": "docker start redis-dev || docker run -d -p 6379:6379 --name redis-dev --restart unless-stopped redis",
    "dev:full": "npm run redis && concurrently -n web,api -c cyan,magenta \"npm run dev\" \"nodemon backend/server.js\"",
    "eval:mentor": "node backend/scripts/evalMentor.js",
    "test:unit": "vitest run --config config/vitest.unit.config.js",
    "test:unit:watch": "vitest --config config/vitest.unit.config.js",
    "test:unit:coverage": "vitest run --config config/vitest.unit.config.js --coverage",
    "test:frontend": "vitest run --config config/vitest.frontend.config.js",
    "test:integration": "vitest run --config config/vitest.integration.config.js",
    "test:integration:watch": "vitest --config config/vitest.integration.config.js",
    "test:concurrency": "vitest run --config config/vitest.concurrency.config.js",
    "test:api": "vitest run --config config/vitest.api.config.js",
    "test:websocket": "vitest run --config config/vitest.websocket.config.js",
    "test:queue": "vitest run --config config/vitest.queue.config.js",
    "test:performance": "vitest run --config config/vitest.performance.config.js",
    "test:security": "vitest run --config config/vitest.security.config.js",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@lezer/highlight": "^1.2.4",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@polar-sh/sdk": "^1.0.1",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.11",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.11.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.1",
    "busboy": "^1.6.0",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.27.1",
    "google-auth-library": "^10.6.2",
    "groq-sdk": "^1.2.1",
    "gsap": "^3.13.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.12.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "ldrs": "^1.1.9",
    "lucide-react": "^0.536.0",
    "mongodb": "^6.19.0",
    "motion": "^12.38.0",
    "picomatch": "^4.0.7",
    "posthog-js": "^1.407.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-loading-skeleton": "^3.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.7.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.19.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "lint-staged": {
    "**/*.{js,jsx}": "eslint --fix"
  },
  "optionalDependencies": {
    "isolated-vm": "~6.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.17",
    "vite": "^7.0.4",
    "vitest": "^4.1.2"
  }
}
